    {
      "name": "RunV2_DBLGreaterThan",
      "desc": "",
      "actType": "atRunExtApp",
      "mainItem": false,
      "mutExcl": true,
      "newStates": [],
      "makeInputFileCode": "return @\"..\\EMRALDTests\\ActionsTest\\GreaterThanResults.txt \" + V2_Dbl.ToString() + \" 110.0\";",
      "exePath": "..\\Other\\GreaterThan.exe",
      "processOutputFileCode": "StreamReader reader = File.OpenText(@\"..\\EMRALDTests\\ActionsTest\\GreaterThanResults.txt\");\nvar s = reader.ReadLine();\nreader.Dispose();\nList<String> retStates = new List<String>();\nif (s == \"True\")\n{\n    retStates.Add(\"+OK\");\n}\nelse\n{\n    retStates.Add(\"+Fail\");\n}\n\nretStates.Add(\"-S3\");\n\nreturn retStates;",
      "codeVariables": [
        "V2_Dbl"
      ],
      "id": "40e65105-7dd9-4cb4-9a2a-7e52c5171555",
      "objType": "Action"
    },
    {
      "name": "Set_V1",
      "desc": "",
      "actType": "atCngVarVal",
      "mainItem": false,
      "mutExcl": true,
      "newStates": [],
      "scriptCode": "if((V4_String == \"Hello\") && (V3_Bool == true))\n  return V1_Int * 2;\nelse\n  return 100;",
      "variableName": "V1_Int",
      "codeVariables": [
        "V2_Dbl",
        "V3_Bool",
        "V4_String"
      ],
      "id": "4a31aeaa-4670-45b8-b3c1-c296d266112a",
      "objType": "Action"
    },
    {
      "name": "SetV2",
      "desc": "",
      "actType": "atCngVarVal",
      "mainItem": false,
      "mutExcl": true,
      "newStates": [],
      "scriptCode": "if(V4_String == \"Reset\")\n  return 0.555;\nelse\n  return V2_Dbl * V1_Int;",
      "variableName": "V2_Dbl",
      "codeVariables": [
        "V1_Int",
        "V4_String"
      ],
      "id": "61d91794-d717-4c44-8b60-962a7dfe0d13",
      "objType": "Action"
    },
    {
      "name": "SetV4_String",
      "desc": "",
      "actType": "atCngVarVal",
      "mainItem": false,
      "mutExcl": true,
      "newStates": [],
      "scriptCode": "if(V2_Dbl > .555)\n  return \"Reset\";\nelse\n  return \"Hello\";",
      "variableName": "V4_String",
      "codeVariables": [
        "V2_Dbl"
      ],
      "id": "7aa953db-7b84-4eeb-ad42-9e48e841834d",
      "objType": "Action"
    }
